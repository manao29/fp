# === 企业微信 (WeCom) ===
# 企业 ID，在企业管理后台"我的企业"页面底部查看
WECOM_CORP_ID=
# 应用 Secret，在"应用管理"中自建应用获取
WECOM_AGENT_SECRET=
# 自建应用的 AgentId
WECOM_AGENT_ID=
# 回调 Token (接收消息验证用)
WECOM_TOKEN=
# 回调 EncodingAESKey (消息加解密用)
WECOM_ENCODING_AES_KEY=

# === AI 模型 ===
# OpenAI 兼容接口地址 (阿里 DashScope / DeepSeek / 本地 Ollama)
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_API_KEY=
AI_MODEL=qwen-plus
# 用于简单意图分类的轻量模型 (可选，不设则复用 AI_MODEL)
AI_LIGHT_MODEL=qwen-turbo
# API 调用超时 (秒)
AI_TIMEOUT=30

# === OCR ===
# paddleocr | none
OCR_ENGINE=paddleocr

# === 数据库 ===
# sqlite 文件路径 (默认项目根目录下的 data/invoice.db)
DB_PATH=data/invoice.db

# === 文件上传 ===
# 上传文件存储目录
UPLOAD_DIR=data/uploads
# 最大上传大小 (MB)
MAX_UPLOAD_SIZE_MB=20

# === 服务配置 ===
# 服务监听地址
HOST=0.0.0.0
PORT=8000
# 日志级别: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# === 前端 ===
# 前端访问地址 (用于生成消息中的链接)
FRONTEND_URL=http://localhost:8000

# === 业务配置 ===
# 自动确认时间 (分钟)，0 表示不自动确认
AUTO_CONFIRM_MINUTES=30
# 会话活跃窗口 (分钟)，超过此时间视为新会话
ACTIVE_WINDOW_MINUTES=180
# 群聊触发别名 (机器人被@时的名字，逗号分隔)
BOT_ALIASES=开票助手,开票客服,发票助手

# === 企查查 (买方资料补全) ===
QICHACHA_API_KEY=
QICHACHA_SECRET_KEY=

# === 安全 ===
# 调试接口密钥 (设为空则调试接口不可用)
DEBUG_SECRET=
